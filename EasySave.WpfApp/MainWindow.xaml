<Window x:Class="EasySave.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave v2.0" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  
            <RowDefinition Height="*"/>     
            <RowDefinition Height="Auto"/>  
            <RowDefinition Height="Auto"/>  
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Ajouter un job" Width="150" Height="30" Click="AddJob_Click" Margin="0,0,10,0"/>
            <Button Content="Supprimer le job sélectionné" Width="200" Height="30" Click="DeleteJob_Click"/>
        </StackPanel>
        
        <DataGrid Grid.Row="1" x:Name="JobsDataGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single"/>

        <Button Grid.Row="2" Content="Lancer la sauvegarde sélectionnée" Width="250" Height="30" Margin="0,10,0,0"
                Click="RunJob_Click" HorizontalAlignment="Center"/>

        <Button Grid.Row="3" Content="Réinitialiser la liste de jobs" Width="180" Height="24" Margin="0,5,0,0"
                Click="ResetJobs_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>



    </Grid>
</Window>
