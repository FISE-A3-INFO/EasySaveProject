<Window x:Class="EasySave.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave v2.0" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Ajouter un job" Width="150" Height="30" Margin="0,0,0,10" Click="AddJob_Click"/>
        <DataGrid Grid.Row="1" x:Name="JobsDataGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>
