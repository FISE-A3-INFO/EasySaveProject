<Window x:Class="EasySave.WpfApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [SettingsWindowTitle], Source={StaticResource Res}}"
        Height="470" Width="410"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Choix de langue -->
        <Label Content="{Binding [LanguageLabel], Source={StaticResource Res}}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="LanguageComboBox" Grid.Row="0" Grid.Column="1" Width="150">
            <ComboBoxItem Content="{Binding [LanguageFrench], Source={StaticResource Res}}" Tag="fr"/>
            <ComboBoxItem Content="{Binding [LanguageEnglish], Source={StaticResource Res}}" Tag="en"/>
        </ComboBox>

        <!-- Choix du format de log -->
        <Label Content="{Binding [LogFormatLabel], Source={StaticResource Res}}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="LogFormatComboBox" Grid.Row="2" Grid.Column="1" Width="150">
            <ComboBoxItem Content="JSON" Tag="json"/>
            <ComboBoxItem Content="XML" Tag="xml"/>
        </ComboBox>

        <!-- Logiciel métier -->
        <Label Content="Logiciel métier à surveiller (nom du processus, ex: calc.exe)" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="BusinessSoftwareTextBox" Grid.Row="3" Grid.Column="1" Width="150" />

        <!-- Extensions prioritaires -->
        <Label Content="Extensions prioritaires (une par ligne, ex: .pdf)" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" />
        <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Top">
            <ListBox x:Name="ExtensionsListBox" Height="70" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="AddExtensionTextBox" Width="70" Margin="0,0,5,0"/>
                <Button Content="Ajouter" Click="AddExtension_Click" Width="60"/>
                <Button Content="Supprimer" Click="RemoveExtension_Click" Width="80" Margin="5,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Seuil fichier volumineux -->
        <Label Content="Seuil fichier volumineux (Ko) :" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="LargeFileSizeTextBox" Grid.Row="5" Grid.Column="1" Width="100" />

        <!-- Bouton de sauvegarde -->
        <Button Grid.Row="6" Grid.ColumnSpan="2"
                Content="{Binding [SaveButton], Source={StaticResource Res}}"
                HorizontalAlignment="Center"
                Width="100"
                Margin="0,20,0,0"
                Click="SaveSettings_Click"/>
    </Grid>
</Window>
