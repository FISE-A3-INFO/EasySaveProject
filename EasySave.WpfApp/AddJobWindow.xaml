<Window x:Class="EasySave.WpfApp.AddJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une sauvegarde" Height="270" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Nom :" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,5" />

        <TextBlock Text="Source :" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
        <TextBox x:Name="SourceBox" Grid.Row="1" Grid.Column="1" Margin="0,5" />

        <TextBlock Text="Cible :" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
        <TextBox x:Name="TargetBox" Grid.Row="2" Grid.Column="1" Margin="0,5" />

        <TextBlock Text="Type :" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
        <ComboBox x:Name="TypeBox" Grid.Row="3" Grid.Column="1" Margin="0,5" SelectedIndex="0">
            <ComboBoxItem Content="Complète" Tag="Full" />
            <ComboBoxItem Content="Différentielle" Tag="Differential" />
        </ComboBox>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Ajouter" Width="80" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
