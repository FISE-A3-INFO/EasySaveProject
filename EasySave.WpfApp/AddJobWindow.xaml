<Window x:Class="EasySave.WpfApp.AddJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasySave.WpfApp.Services"
        Title="{Binding Source={StaticResource Res}, Path=[WindowTitle]}"
        Height="270" Width="400" WindowStartupLocation="CenterOwner">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<TextBlock Text="{Binding [NameLabel], Source={StaticResource Res}}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
		<TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

		<TextBlock Text="{Binding [SourceLabel], Source={StaticResource Res}}" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
		<TextBox x:Name="SourceBox" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

		<TextBlock Text="{Binding [TargetLabel], Source={StaticResource Res}}" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
		<TextBox x:Name="TargetBox" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

		<TextBlock Text="{Binding [TypeLabel], Source={StaticResource Res}}" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
		<ComboBox x:Name="TypeBox" Grid.Row="3" Grid.Column="1" Margin="0,5" SelectedIndex="0">
			<ComboBoxItem Content="{Binding [TypeFull], Source={StaticResource Res}}" Tag="Full"/>
			<ComboBoxItem Content="{Binding [TypeDiff], Source={StaticResource Res}}" Tag="Differential"/>
		</ComboBox>

		<StackPanel Orientation="Horizontal" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,15,0,0">
			<Button Content="{Binding [CancelButton], Source={StaticResource Res}}" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
			<Button Content="{Binding [AddButton], Source={StaticResource Res}}" Width="80" Click="Add_Click"/>
		</StackPanel>
	</Grid>
</Window>
